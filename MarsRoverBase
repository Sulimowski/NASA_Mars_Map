CREATE TABLE Agencies (
    agency_id INT IDENTITY(1,1) PRIMARY KEY,
    name VARCHAR(100) NOT NULL UNIQUE,
    country VARCHAR(100) NOT NULL,
    founded_year INT NULL
);

CREATE TABLE Rovers (
    rover_id INT IDENTITY(1,1) PRIMARY KEY,
    agency_id INT NOT NULL,
    name VARCHAR(100) NOT NULL UNIQUE,
    mission_status VARCHAR(20) NOT NULL CHECK (mission_status IN ('Active', 'Completed', 'Lost', 'Planned')),
    landing_date DATE NULL,
    end_date DATE NULL,
    landing_site VARCHAR(150) NOT NULL,
    landing_lat DECIMAL(9, 6) NOT NULL, 
    landing_lon DECIMAL(9, 6) NOT NULL, 
    power_source VARCHAR(50) NOT NULL,  
    total_distance_km DECIMAL(10, 3) DEFAULT 0,
    CONSTRAINT FK_Rovers_Agencies FOREIGN KEY (agency_id) REFERENCES Agencies(agency_id)
);

CREATE TABLE Instruments (
    instrument_id INT IDENTITY(1,1) PRIMARY KEY,
    rover_id INT NOT NULL,
    code_name VARCHAR(30) NOT NULL,     
    full_name VARCHAR(200) NOT NULL,
    instrument_type VARCHAR(50) NOT NULL, 
    status VARCHAR(20) NOT NULL DEFAULT 'Operational' CHECK (status IN ('Operational', 'Degraded', 'Offline')),
    CONSTRAINT FK_Instruments_Rovers FOREIGN KEY (rover_id) REFERENCES Rovers(rover_id) ON DELETE CASCADE,
    CONSTRAINT UQ_Rover_Instrument UNIQUE (rover_id, code_name)
);


CREATE TABLE Waypoints (
    waypoint_id INT IDENTITY(1,1) PRIMARY KEY,
    rover_id INT NOT NULL,
    sol INT NOT NULL CHECK (sol >= 0),
    earth_date DATE NOT NULL,
    latitude DECIMAL(9, 6) NOT NULL,
    longitude DECIMAL(9, 6) NOT NULL,
    elevation_m DECIMAL(8, 2) NULL,
    region_name VARCHAR(150) NULL,
    CONSTRAINT FK_Waypoints_Rovers FOREIGN KEY (rover_id) REFERENCES Rovers(rover_id) ON DELETE CASCADE
);


CREATE TABLE Telemetry (
    telemetry_id INT IDENTITY(1,1) PRIMARY KEY,
    rover_id INT NOT NULL,
    sol INT NOT NULL CHECK (sol >= 0),
    earth_date DATE NOT NULL,
    min_temp_c DECIMAL(5, 2) NULL,
    max_temp_c DECIMAL(5, 2) NULL,
    pressure_pa DECIMAL(7, 2) NULL,
    radiation_msv DECIMAL(6, 3) NULL,
    battery_level_pct TINYINT NULL CHECK (battery_level_pct BETWEEN 0 AND 100),
    CONSTRAINT FK_Telemetry_Rovers FOREIGN KEY (rover_id) REFERENCES Rovers(rover_id) ON DELETE CASCADE,
    CONSTRAINT UQ_Rover_Telemetry_Sol UNIQUE (rover_id, sol)
);


CREATE TABLE Rover_Media (
    media_id INT IDENTITY(1,1) PRIMARY KEY,
    rover_id INT NOT NULL,
    instrument_id INT NOT NULL,
    waypoint_id INT NULL,
    sol INT NOT NULL CHECK (sol >= 0),
    earth_date DATETIME2 NOT NULL,
    image_url VARCHAR(500) NOT NULL,
    caption VARCHAR(500) NULL,
    CONSTRAINT FK_Media_Rovers FOREIGN KEY (rover_id) REFERENCES Rovers(rover_id),
    CONSTRAINT FK_Media_Instruments FOREIGN KEY (instrument_id) REFERENCES Instruments(instrument_id),
    CONSTRAINT FK_Media_Waypoints FOREIGN KEY (waypoint_id) REFERENCES Waypoints(waypoint_id) ON DELETE SET NULL
);


CREATE TABLE Samples (
    sample_id INT IDENTITY(1,1) PRIMARY KEY,
    rover_id INT NOT NULL,
    waypoint_id INT NULL,
    sol INT NOT NULL CHECK (sol >= 0),
    sample_code VARCHAR(50) NOT NULL UNIQUE, 
    rock_type VARCHAR(100) NULL,             
    composition_notes VARCHAR(1000) NULL,
    is_cached BIT NOT NULL DEFAULT 0,       
    CONSTRAINT FK_Samples_Rovers FOREIGN KEY (rover_id) REFERENCES Rovers(rover_id),
    CONSTRAINT FK_Samples_Waypoints FOREIGN KEY (waypoint_id) REFERENCES Waypoints(waypoint_id) ON DELETE SET NULL
);


CREATE INDEX IX_Waypoints_Rover_Sol ON Waypoints(rover_id, sol);
CREATE INDEX IX_Media_Rover_Sol ON Rover_Media(rover_id, sol);
CREATE INDEX IX_Telemetry_Rover_Date ON Telemetry(rover_id, earth_date);
